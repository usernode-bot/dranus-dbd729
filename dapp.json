{
  "description": "Buat film drama pendek dari ide sampai video siap putar",
  "icon": { "image": "brand/icon.png" },
  "secrets": [],
  "llm": {
    "purpose": "Menulis ide cerita dan draf naskah drama pendek",
    "suggested_daily_cap_cents": 100
  },
  "tests": [
    {
      "name": "Home shows the project screen",
      "path": "/",
      "expectSelector": "[data-testid=home-start]"
    },
    {
      "name": "Home header shows the DRANUS logo",
      "path": "/",
      "expectSelector": ".hdr img[data-testid=app-logo][src='/logo.svg']"
    },
    {
      "id": "studio.new-project",
      "name": "New project opens the wizard on Ide",
      "path": "/#/baru",
      "expectSelector": "[data-testid=step-ide]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Idea step offers Give Me Ideas",
      "path": "/#/baru",
      "expectSelector": "[data-testid=give-ideas]"
    },
    {
      "name": "Duration picker offers 1 hour",
      "path": "/#/baru",
      "expectSelector": ".seg[data-seg=target] button[data-v=\"60\"]"
    },
    {
      "name": "Template list shows the built-in stories",
      "path": "/#/templat",
      "expectSelector": "[data-testid=template-card]"
    },
    {
      "name": "Story outline screen opens",
      "path": "/#/cerita",
      "expectSelector": "[data-testid=outline-premise]"
    },
    {
      "id": "studio.outline",
      "name": "Story outline builds from a premise",
      "path": "/#/cerita",
      "expectSelector": "[data-testid=make-outline]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "studio.template-player",
      "name": "Template preview player renders",
      "path": "/#/templat/surat-dari-ibu",
      "expectSelector": "[data-testid=player-canvas]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Royal palace template plays",
      "path": "/#/templat/rahasia-istana-terlarang",
      "expectSelector": "[data-testid=player-canvas]"
    },
    {
      "id": "studio.character-faces",
      "name": "Template characters show photo faces",
      "path": "/#/templat/surat-dari-ibu",
      "expectSelector": "img.face-img[src*='/faces/']",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/faces/**"
      ]
    },
    {
      "id": "studio.face-upload",
      "name": "Face sheet offers gallery upload",
      "path": "/#/templat/surat-dari-ibu/wajah",
      "expectSelector": "[data-testid=face-upload]",
      "visual": true,
      "impact": ["public/index.html"]
    },
    {
      "name": "Face sheet keeps a gallery photo library",
      "path": "/#/templat/surat-dari-ibu/wajah",
      "expectSelector": "[data-testid=face-library]"
    },
    {
      "id": "studio.save-frame",
      "name": "Player offers Save Image",
      "path": "/#/templat/surat-dari-ibu",
      "expectSelector": "[data-testid=save-frame]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "id": "studio.save-gallery-bar",
      "name": "Wizard bottom bar always offers Save to Gallery",
      "path": "/#/baru",
      "expectSelector": "[data-testid=step-ide] ~ .stepfoot [data-testid=save-gallery-bar]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    }
  ],
  "governance": {
    "approvers": "invited",
    "approvals": "default"
  }
}
